{
  "name": "k-hole",
  "short_name": "k-hole",
  "description": "Your k-hole computer from this phone: Remote, k-beam, Agents and the Assistant",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#131819",
  "theme_color": "#131819",
  "share_target": {
    "action": "/beam/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url", "files": [{ "name": "files", "accept": ["*/*"] }] }
  },
  "icons": [
    { "src": "/remote/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/remote/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/remote/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/remote/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ]
}
